# Proxy TLS da hospedagem futura. DM_DOMAIN vem do ambiente (ex.: monitor.daticopy.com.br).
{$DM_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# A página da impressora (/devweb) pode usar frames dela mesma; o gateway já manda SAMEORIGIN e a
	# CSP "sandbox" que a isola do portal. O resto do site nunca vai em frame.
	@not_devweb not path /devweb/*
	header @not_devweb X-Frame-Options "DENY"

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/agent* {
		reverse_proxy gateway:8001
	}
	handle /devweb/* {
		reverse_proxy gateway:8001
	}
	handle {
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}
}
