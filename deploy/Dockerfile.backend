# Imagem única do backend (API, gateway e worker mudam só o comando).
# Preparada para a hospedagem futura; NÃO é usada no desenvolvimento (sem Docker nesta fase).
# Build a partir da raiz do repositório: docker build -f deploy/Dockerfile.backend .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

COPY backend/requirements.lock backend/requirements.lock
RUN pip install --no-cache-dir -r backend/requirements.lock

COPY product.json product.json
COPY profiles profiles
# install.sh servido em /api/public/install.sh (preenchido com o servidor e o código).
COPY installer/linux installer/linux
COPY backend backend
RUN pip install --no-cache-dir --no-deps -e backend \
    && useradd --system --home /srv --shell /usr/sbin/nologin dati
USER dati
WORKDIR /srv/backend

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
