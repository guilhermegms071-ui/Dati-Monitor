# Copie para .env (que NUNCA é versionado) e preencha. Todos os segredos ficam só aqui.

# --- PostgreSQL local (usado por scripts\setup-db.ps1) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=            # senha definida na instalação do PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_APP_USER=dati                        # papel da aplicação (criado pelo setup-db.ps1)
DB_APP_PASSWORD=                        # gere uma senha aleatória longa, sem aspas simples

# --- Backend (API, gateway, worker) ---
# Mesma senha de DB_APP_PASSWORD.
DATABASE_URL=postgresql+asyncpg://dati:SENHA@127.0.0.1:5432/dati_dev
TEST_DATABASE_URL=postgresql+asyncpg://dati:SENHA@127.0.0.1:5432/dati_test
APP_ENV=development                     # development | test | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
# CORS_ORIGINS=["http://localhost:5173"]   # opcional; padrão já libera o portal local
# DB_CHECK_INTERVAL_SECONDS=30             # opcional; intervalo do teste de banco do worker

# --- Hospedagem futura (deploy/docker-compose.yml) ---
# DM_DOMAIN=monitor.exemplo.com.br
