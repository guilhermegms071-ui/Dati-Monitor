# Copie para .env (que NUNCA é versionado) e preencha. Todos os segredos ficam só aqui.

# --- PostgreSQL local (usado por scripts\setup-db.ps1) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=            # senha definida na instalação do PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_APP_USER=dati                        # papel da aplicação (criado pelo setup-db.ps1)
DB_APP_PASSWORD=                        # gere uma senha aleatória longa, sem aspas simples

# --- Backend (API, gateway, worker) ---
# Mesma senha de DB_APP_PASSWORD.
DATABASE_URL=postgresql+asyncpg://dati:SENHA@127.0.0.1:5432/dati_dev
TEST_DATABASE_URL=postgresql+asyncpg://dati:SENHA@127.0.0.1:5432/dati_test
APP_ENV=development                     # development | test | production

# Segredos do backend. Gere com scripts\init-env.ps1 (nunca reutilize os de outro ambiente).
JWT_SECRET=                             # >= 32 caracteres aleatórios (assina os tokens do portal)
MASTER_KEY=                             # 32 bytes em base64 (AES-256-GCM das credenciais SNMP/WhatsApp)
COOKIE_SECURE=false                     # true em produção (HTTPS); false só no localhost de desenvolvimento
PUBLIC_BASE_URL=http://localhost:5173   # usado nos links dos e-mails (redefinição de senha)
PUBLIC_SERVER_URL=http://127.0.0.1:8000 # endereço que os coletores usam (vai no comando de cadastro)
PUBLIC_WS_URL=ws://127.0.0.1:8001/ws/agent   # canal WebSocket dos coletores; em produção deixe vazio (wss://mesmo-host/ws/agent)
# COMMAND_EXPIRY_MINUTES=10             # validade padrão dos comandos remotos
# STORAGE_DIR=var/storage               # onde ficam logs e walks enviados pelos coletores
# DEVICE_DISCONNECTED_HOURS=6          # sem leitura há tantas horas = "desconectado" no parque
SMTP_HOST=127.0.0.1                     # dev: scripts\smtp_catcher.py
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_FROM=Dati Monitor <nao-responda@exemplo.com.br>
# BOOTSTRAP_RESELLER_NAME=Daticopy      # revenda criada no primeiro start
# BOOTSTRAP_ADMIN_EMAIL=admin@local     # superadmin criado no primeiro start (senha exibida no console)
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
# CORS_ORIGINS=["http://localhost:5173"]   # opcional; padrão já libera o portal local
# DB_CHECK_INTERVAL_SECONDS=30             # opcional; intervalo do teste de banco do worker

# --- Hospedagem futura (deploy/docker-compose.yml) ---
# DM_DOMAIN=monitor.exemplo.com.br
